# Copiar a .env y ajustar valores
# Contraseña de SA: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos
SA_PASSWORD=GestorTurnos#2026

# Development habilita Scalar en http://localhost:5032/scalar
ASPNETCORE_ENVIRONMENT=Development

# Puertos expuestos en el host
WEB_PORT=4200
API_PORT=5032
SQL_PORT=14333

# Rutas a los repositorios (relativas a esta carpeta)
BACKEND_PATH=../gestor-turnos-backend
FRONTEND_PATH=../gestor-turnos-frontend
